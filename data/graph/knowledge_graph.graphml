      <data key="d4">EXTENDS</data>
      <data key="d5">0.7</data>
      <data key="d6">02b041767d7dc172514a0150432920b31075bf4d</data>
      <data key="d7">2024</data>
      <data key="d8">These findings align with chemical intuition and existing literature, reinforcing their validity.</data>
    </edge>
