      <data key="d7">2024</data>
      <data key="d8">In this review, we offer a comprehensive overview of the prevailing methods proposed to quantify the uncertainty inherent in machine learning models developed for various medical image tasks.</data>
    </edge>
    <edge source="Uncertainty evaluation protocols" target="Medical Images" id="0">
      <data key="d4">EVALUATES_ON</data>
      <data key="d5">0.8</data>
