      <data key="d7">2022</data>
      <data key="d8">However, the existing studies were conducted at a single location and had low prediction performance.</data>
    </edge>
    <edge source="Gradient Boosted Regression Tree" target="Recreational Beaches" id="0">
      <data key="d4">APPLIED_TO</data>
      <data key="d5">0.9</data>
