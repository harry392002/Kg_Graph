      <data key="d7">2022</data>
      <data key="d8">We used hydro-meteorological and qPCR data from the beaches in South Korea and Pakistan</data>
    </edge>
    <edge source="Gradient Boosted Regression Tree" target="Existing Studies" id="0">
      <data key="d4">IMPROVES</data>
      <data key="d5">0.8</data>
