      <data key="d7">2023</data>
      <data key="d8">To evaluate the effectiveness of GCNNMMA, we implement two different cross-validation (CV) methods based on two different datasets.</data>
    </edge>
    <edge source="GCNNMMA" target="other comparison models" id="0">
      <data key="d4">IMPROVES</data>
