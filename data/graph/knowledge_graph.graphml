      <data key="d7">2021</data>
      <data key="d8">These results together indicate that oxytocin may increase the ability to overcome the corresponding internal oscillation dispersion and support the flexibility in neural synchrony in various social contexts, providing new evidence for explaining the oxytocin modulated social behaviors.</data>
    </edge>
    <edge source="Kuramoto model" target="network neuroscience" id="0">
      <data key="d4">EXTENDS</data>
